{
  "name": "analise-criminal-gtb-v2-frontend",
  "private": true,
  "version": "0.1.123",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "format": "prettier --write src/main.tsx src/components/CrimeMap.tsx src/components/ActivityLog.tsx",
    "format:check": "prettier --check src/main.tsx src/components/CrimeMap.tsx src/components/ActivityLog.tsx"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "echarts": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
